{
  "name": "nemotron-transcribe-demo-video",
  "version": "0.1.0",
  "private": true,
  "description": "Three caption videos from real NVIDIA Nemotron 3.5 Transcribe H100 outputs",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "npm run render:conversation && npm run render:jfk && npm run render:artemis",
    "render:conversation": "remotion render src/index.ts NemotronCaptionClip out/conversation-caption.mp4 --props=./clip-props/conversation.json",
    "render:jfk": "remotion render src/index.ts NemotronCaptionClip out/jfk-caption.mp4 --props=./clip-props/jfk.json",
    "render:artemis": "remotion render src/index.ts NemotronCaptionClip out/artemis-caption.mp4 --props=./clip-props/artemis.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/media-utils": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "typescript": "5.9.3"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
